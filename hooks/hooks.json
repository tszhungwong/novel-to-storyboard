{
  "description": "改了分鏡的設定檔、分鏡檔、分集表或分集劇本時，自動跑一次檢查，把錯誤與警告回給模型（只檢查，不更新產出）",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-storyboard.cjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
